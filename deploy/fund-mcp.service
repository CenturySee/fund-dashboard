[Unit]
Description=Fund Dashboard MCP
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/fund-mcp
EnvironmentFile=/etc/fund-mcp.env
ExecStart=/opt/fund-mcp/node/bin/node /opt/fund-mcp/dist/index.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
